PORT=5000
NODE_ENV=development

# Comma-separated browser origins allowed by CORS (your Vercel app + locals if needed)
CLIENT_ORIGINS=https://shoe-testing-frontend.vercel.app

# Report & bug report email (Google Workspace / Gmail SMTP)
# TLS: port 587, SMTP_SECURE=false  |  SSL: port 465, SMTP_SECURE=true
BUG_REPORT_TO_EMAIL=Integration@virolaindia.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=Integration@virolaindia.com
SMTP_PASS=your-app-or-account-password
SMTP_FROM=Integration@virolaindia.com

# Add your DB, JWT_SECRET, etc. alongside these.
